{
  "name": "dsh-quote-annotate-pro",
  "version": "0.4.3",
  "description": "DSH 会话与文档预览里的划词批注：带编号的引用块在输入框和已发送消息里始终可见、点一下跳回原文；docx/PDF/Markdown/代码与 Excel 选区批注可攒起来一次性发送；批注框支持语音输入。",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "quote", "annotate", "selection", "reference", "anchor"],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "tools", "docs", "cordis.patch.yml", "README.md", "README.en.md", "SUMMARY.md", "CHANGELOG.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhao-guang-ai/dsh-quote-annotate-pro.git"
  },
  "homepage": "https://github.com/zhao-guang-ai/dsh-quote-annotate-pro#readme",
  "bugs": {
    "url": "https://github.com/zhao-guang-ai/dsh-quote-annotate-pro/issues"
  },
  "scripts": {
    "check": "node tools/check-manifest.mjs",
    "test": "node tools/test-client.mjs",
    "diag": "node tools/diag-sink.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
